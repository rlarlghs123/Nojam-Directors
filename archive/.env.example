# Copy this file to .env and fill it in.

# ── Where your files live ───────────────────────────────────────────────
# Any folder works. Put it inside a cloud drive and it becomes your "internal cloud":
#   iCloud Drive (Mac):         ARCHIVE_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Archive"
#   Google Drive (Mac):         ARCHIVE_DIR="~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/Archive"
#   Google Drive (Windows):     ARCHIVE_DIR="G:/My Drive/Archive"
#   NAS / Docker:               set in docker-compose.yml instead
ARCHIVE_DIR=./library

# Search index and thumbnails. Keep this OUT of the synced folder (the default is fine).
DATA_DIR=./data

# ── Claude auto-tagging ─────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/  (leave empty to run without auto-tags)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# First language = the language of the tags. Extra languages are added as hidden
# search keywords, so e.g. "en,ko" lets you search in Korean for English tags.
ARCHIVE_LANGUAGES=en
# Ask before auto-tagging more than this many waiting items (e.g. the first scan of a big folder).
TAG_CONFIRM_OVER=50
# AUTO_TAG=off

# ── Web server ──────────────────────────────────────────────────────────
ARCHIVE_TITLE=Nojam Archive
PORT=3000
# 127.0.0.1 = this computer only (use Tailscale to reach it from your phone, see README).
# 0.0.0.0   = anyone on your Wi-Fi; then also set ARCHIVE_PASSWORD.
HOST=127.0.0.1
# ARCHIVE_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg   # found automatically in most cases
# RESCAN_MINUTES=10                      # full rescan interval (the folder is also watched live)
# MAX_UPLOAD_MB=4096
