# Copy this file to .env and fill it in.

# ── Where your files live ───────────────────────────────────────────────
# Any folder works. Put it inside a cloud drive and it becomes your "internal cloud":
#   iCloud Drive (Mac):         ARCHIVE_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Archive"
#   Google Drive (Mac):         ARCHIVE_DIR="~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/Archive"
#   Google Drive (Windows):     ARCHIVE_DIR="G:/My Drive/Archive"
#   NAS / Docker:               set in docker-compose.yml instead
ARCHIVE_DIR=./library

# Search index and thumbnails. Keep this OUT of the synced folder (the default is fine).
DATA_DIR=./data

# ── Auto-tagging ───────────────────────────────────────────────────────
# Who writes the tags (see "Auto-tagging" in the README):
#   ollama      FREE (the default). Runs on this computer, nothing leaves it.
#               Install Ollama from ollama.com, keep it running, then once: ollama pull qwen3-vl:8b-instruct
#   claude      Anthropic Claude: most precise tags, paid (about $0.03 per block). Needs ANTHROPIC_API_KEY.
#   gemini      FREE tier of Google Gemini, limited per day. Needs TAG_API_KEY (aistudio.google.com).
#               Google may use free-tier content to improve its products.
#   openrouter  FREE models on OpenRouter, 50 a day. Needs TAG_API_KEY (openrouter.ai/keys).
#   custom      any OpenAI-compatible API (LM Studio, …): set TAG_API_URL and TAG_MODEL.
TAGGER=ollama

# Only for TAGGER=claude: get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Optional: another model than the tagger's default
#   ollama: qwen3-vl:8b-instruct (for 8 GB Macs: qwen3-vl:4b-instruct) · claude: claude-opus-5
#   gemini: gemini-3.5-flash-lite · openrouter: openrouter/free
# TAG_MODEL=
# TAG_API_KEY=                 # for gemini / openrouter / custom
# TAG_API_URL=                 # e.g. http://192.168.0.20:11434 for Ollama on another computer

# First language = the language of the tags. Extra languages are added as hidden
# search keywords, so e.g. "en,ko" lets you search in Korean for English tags.
ARCHIVE_LANGUAGES=en
# With a paid tagger, ask before tagging more than this many waiting blocks (e.g. the first scan of a big folder).
TAG_CONFIRM_OVER=50
# AUTO_TAG=off                 # never send anything for tagging

# ── Web server ──────────────────────────────────────────────────────────
ARCHIVE_TITLE=Nojam Archive
PORT=3000
# 127.0.0.1 = this computer only (use Tailscale to reach it from your phone, see README).
# 0.0.0.0   = anyone on your Wi-Fi; then also set ARCHIVE_PASSWORD.
HOST=127.0.0.1
# ARCHIVE_PASSWORD="…"          # keep the quotes: a # without them starts a comment
# With Docker (docker-compose.yml): ARCHIVE_BIND=127.0.0.1 publishes the page on the server itself only (the cloud
# setup puts Tailscale in front of it), and ARCHIVE_USER=1000:1000 writes files as your user instead of root.
# ARCHIVE_BIND=127.0.0.1
# ARCHIVE_USER=1000:1000

# ── Optional ────────────────────────────────────────────────────────────
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg   # found automatically in most cases
# RESCAN_MINUTES=10                      # full rescan interval (the folder is also watched live)
# MAX_UPLOAD_MB=4096
